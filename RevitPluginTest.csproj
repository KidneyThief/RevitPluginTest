<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- RevitPluginTest.Core is a separate, nested project; without this the
         host's default globs would also pull in Core's own source and obj\ output. -->
    <Compile Remove="RevitPluginTest.Core\**\*.cs" />
    <None Remove="RevitPluginTest.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>..\..\..\..\..\..\..\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\..\..\..\..\..\..\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyAddinManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\RevitPluginTest.addin" DestinationFolder="$(APPDATA)\Autodesk\Revit\Addins\2027\" />
  </Target>

</Project>
