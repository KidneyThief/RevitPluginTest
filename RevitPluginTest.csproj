<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- RevitPluginTest.Core is a separate, nested project; without this the
         host's default globs would also pull in Core's own source and obj\ output. -->
    <Compile Remove="RevitPluginTest.Core\**\*.cs" />
    <None Remove="RevitPluginTest.Core\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- RevitPluginTest.addin (checked into the repo) is a TEMPLATE containing
       the __ASSEMBLY_PATH__ token, not a usable manifest on its own - the
       real, deployed manifest is generated here on every build by
       substituting $(TargetPath) (this build's actual absolute output DLL
       path), so it's always correct regardless of where the repo is cloned
       to. No manual editing needed for a fresh clone. -->
  <Target Name="CopyAddinManifest" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -Command &quot;(Get-Content -Raw '$(MSBuildProjectDirectory)\RevitPluginTest.addin').Replace('__ASSEMBLY_PATH__', '$(TargetPath)') | Set-Content -Path '$(APPDATA)\Autodesk\Revit\Addins\2027\RevitPluginTest.addin'&quot;" />
  </Target>

</Project>
