<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2027\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Plain HintPath reference (not ProjectReference) on purpose: building Core
         must not trigger a rebuild of the host, whose output Revit may have locked. -->
    <Reference Include="RevitPluginTest">
      <HintPath>..\bin\Debug\net10.0-windows\RevitPluginTest.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
